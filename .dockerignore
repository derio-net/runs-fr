# Keep the build context small and deterministic. The Dockerfile only needs the
# Go module + sources and the web/ frontend sources; everything below is either
# rebuilt inside the image, irrelevant to the build, or risks leaking host state.
.git
.gitignore
.github
.devcontainer
.golangci.yml
Makefile
README.md
docs
charts
bin
# Frontend deps and outputs are reinstalled/rebuilt in the frontend stage.
web/node_modules
web/dist
# bundle.js is generated by the frontend stage; never copy a stale host copy.
cmd/runs-fr/static/bundle.js
# Stray root lockfile (see .gitignore).
/package-lock.json
